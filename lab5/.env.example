BROKER_URL=localhost:9092
FRAMES_TOPIC=camera.frames
DETECTIONS_TOPIC=people.detections
PROCESSING_GROUP_ID=people-counter-processing
STORAGE_GROUP_ID=people-counter-storage

DATABASE_URL=postgresql://people_counter:people_counter@localhost:5432/people_counter

PROCESSING_TCP_HOST=127.0.0.1
PROCESSING_TCP_PORT=6100
STORAGE_TCP_HOST=127.0.0.1
STORAGE_TCP_PORT=6200

CAMERA_ID=camera-001
FPS=1
SOURCE_TYPE=simulated
SOURCE_PATH=
# 0 means unlimited. For video, this runs until the end of the file.
MAX_FRAMES=0

# Default mode uses Ultralytics YOLO11 nano for better person detection.
# If ultralytics/model weights are unavailable, Processing Server falls back to OpenCV HOG.
DETECTOR_MODEL_NAME=yolo11n.pt
OPENCV_MODEL_PATH=
OPENCV_CONFIG_PATH=
CONFIDENCE_THRESHOLD=0.25
RECONNECT_DELAY_SECONDS=2
